{
  // Type check only (npm run typecheck; CI): the app's own JS under strict, against app-sync's .d.ts for the pinned
  // version (devDependency app-sync, the same tag as the import map). Nothing is emitted; the browser runs the files as is.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "paths": { "@core/*": ["./node_modules/app-sync/types/*.d.ts"] }
  },
  "include": ["app/src/**/*.js", "app/src/**/*.d.ts"]
}
