{
  "name": "starter-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'worker/test/*.test.mjs' 'app/test/*.unit.test.mjs' 'tools/test/*.test.mjs'",
    "rules": "cd app && npx -y firebase-tools@13.29.1 emulators:exec --only firestore --project demo-starter-app \"node --test test/rules.test.mjs\"",
    "e2e": "playwright test",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "app-sync": "git+https://github.com/flamingbeing/app-sync.git#v0.9.3",
    "axe-core": "4.14.0",
    "typescript": "7.0.2"
  }
}
